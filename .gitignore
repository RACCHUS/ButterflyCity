# =============== #
# Unity .gitignore
# =============== #

# OS-specific
.DS_Store
Thumbs.db

# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/
MemoryCaptures/

# Asset bundles
*.unitypackage

# Autogenerated VS/JetBrains files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Rider
.idea/
*.iml

# Visual Studio
.vs/

# Other
*.apk
*.aab
*.exe
*.app
*.xcodeproj
*.xcworkspace
*.xcuserstate

# Crash reports
sysinfo.txt

# Cache
*.stackdump
*.log
